---
interface Props {
  title: string;
  description?: string;
  active?: string;
}

import { getCollection, getEntry } from 'astro:content';
import { faFacebook, faInstagram, faYoutube } from '@fortawesome/free-brands-svg-icons';
import { Mail } from '@lucide/astro';

const {
  title,
  description = 'CEIP Caballeros de Santiago',
  active,
} = Astro.props;

const base = '/caballeros';
const [pages, socialEntry] = await Promise.all([
  getCollection('pages'),
  getEntry('social', 'index'),
]);
if (!socialEntry) {
  throw new Error('Missing social links content');
}
const socialLinks = socialEntry.data;
const getIconData = (icon: typeof faInstagram) => {
  const [width, height, , , pathData] = icon.icon;
  return {
    viewBox: `0 0 ${width} ${height}`,
    paths: Array.isArray(pathData) ? pathData : [pathData],
  };
};
const socialIcons = {
  instagram: getIconData(faInstagram),
  youtube: getIconData(faYoutube),
  facebook: getIconData(faFacebook),
};
const contactNavigationItem = { label: 'Contacto', slug: 'contact' };
const topLevelPages = pages
  .filter((page) => !page.data.hide_from_navigation && !page.data.parent_page)
  .sort((a, b) => a.data.order - b.data.order);
const childPages = pages.filter((page) => !page.data.hide_from_navigation);
const regularNavigationItems = [
  { label: 'Inicio', slug: 'home' },
  ...topLevelPages.map((page) => ({
    label: page.data.nav_label || page.data.title,
    slug: page.id,
  })),
  { label: 'Eventos', slug: 'events' },
  { label: 'Noticias', slug: 'news' },
];
const mobileNavigationItems = [
  { label: 'Inicio', slug: 'home' },
  ...topLevelPages.flatMap((page) => [
    {
      label: page.data.nav_label || page.data.title,
      slug: page.id,
    },
    ...childPages
      .filter((child) => child.data.parent_page === page.id)
      .sort((a, b) => a.data.order - b.data.order)
      .map((child) => ({
        label: child.data.nav_label || child.data.title,
        slug: child.id,
      })),
  ]),
  { label: 'Eventos', slug: 'events' },
  { label: 'Noticias', slug: 'news' },
  { label: contactNavigationItem.label, slug: contactNavigationItem.slug },
];
const activePage = pages.find((page) => page.id === active);
const sideNavParent = activePage?.data.parent_page
  ? pages.find((page) => page.id === activePage.data.parent_page)
  : activePage;
const sideNavItems = sideNavParent
  ? pages
      .filter(
        (page) =>
          page.data.parent_page === sideNavParent.id &&
          !page.data.hide_from_navigation,
      )
      .sort((a, b) => a.data.order - b.data.order)
  : [];
const showSideNav =
  Boolean(sideNavParent) &&
  !sideNavParent?.data.hide_from_navigation &&
  sideNavItems.length > 0;

const navigationHref = (slug: string) =>
  slug === 'home' ? `${base}/` : `${base}/${slug}/`;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <div class="nav-fade" aria-hidden="true"></div>
    <header class="site-header">
      <button
        class="menu-toggle"
        type="button"
        data-menu-toggle
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="site-menu"
      >
        <span class="menu-toggle-icon" aria-hidden="true">
          <span></span>
          <span></span>
          <span></span>
        </span>
      </button>
      <a class="brand" href={`${base}/`} aria-label="Caballeros School - Inicio">
        <img
          src={`${base}/images/caballerosdesantiago.svg`}
          alt=""
          width="128"
          height="38"
        />
      </a>
      <a
        class="mobile-contact"
        href={navigationHref(contactNavigationItem.slug)}
        aria-label="Contacto"
      >
        <Mail aria-hidden="true" size={20} />
      </a>
      <div class="site-menu" id="site-menu" data-site-menu aria-hidden="false">
        <button
          class="site-menu-backdrop"
          type="button"
          data-menu-close
          aria-label="Cerrar menú"
        ></button>
        <div class="site-menu-panel">
          <button
            class="site-menu-close"
            type="button"
            data-menu-close
            aria-label="Cerrar menú"
          >
            <span aria-hidden="true">&times;</span>
          </button>
          <nav aria-label="Navegacion principal">
            <div class="nav-pages">
              {regularNavigationItems.map((item) => (
                <a
                  class:list={[
                    {
                      active:
                        active === item.slug ||
                        activePage?.data.parent_page === item.slug,
                    },
                  ]}
                  href={navigationHref(item.slug)}
                >
                  {item.label}
                </a>
              ))}
            </div>
            <div class="mobile-nav-pages">
              {mobileNavigationItems.map((item) => (
                <a
                  class:list={[
                    {
                      active:
                        active === item.slug ||
                        activePage?.data.parent_page === item.slug,
                    },
                  ]}
                  href={navigationHref(item.slug)}
                  aria-current={active === item.slug ? 'page' : undefined}
                >
                  {item.label}
                </a>
              ))}
            </div>
          </nav>
          <a
            class:list={[
              'nav-contact',
              { active: active === contactNavigationItem.slug },
            ]}
            href={navigationHref(contactNavigationItem.slug)}
          >
            {contactNavigationItem.label}
          </a>
        </div>
      </div>
    </header>
    <div
      class:list={[
        'page-content',
        { 'page-content--with-sidenav': showSideNav },
      ]}
    >
      <slot />
      {showSideNav && sideNavParent && (
        <aside class="page-sidenav">
          <nav aria-label={`Secciones de ${sideNavParent.data.nav_label || sideNavParent.data.title}`}>
            {[sideNavParent, ...sideNavItems].map((item) => (
              <a
                class:list={[
                  {
                    active: active === item.id,
                    parent: item.id === sideNavParent.id,
                  },
                ]}
                href={navigationHref(item.id)}
                aria-current={active === item.id ? 'page' : undefined}
              >
                {item.data.nav_label || item.data.title}
              </a>
            ))}
          </nav>
        </aside>
      )}
    </div>
    <footer class="site-footer">
      <div class="site-footer-content">
        <img
          class="footer-brand"
          src={`${base}/images/Asset 3.svg`}
          alt="Logotipo de CEIP Caballeros de Santiago"
          width="120"
          height="120"
        />
        <div class="footer-school-details">
          <address>
            <p>
              <strong>CEIP Caballeros de Santiago</strong><br />
              Pl. de Valdelasgranas, 3 · Centro · 14002 Córdoba<br />
              Tel.: <a href="tel:+34957379954">957 379 954</a>,{' '}
              Móvil: <a href="tel:+34671565544">671 565 544</a>
            </p>
          </address>
          {(socialLinks.instagram || socialLinks.youtube || socialLinks.facebook) && (
            <nav class="footer-social-links" aria-label="Redes sociales">
              {socialLinks.instagram && (
                <a href={socialLinks.instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram">
                  <svg aria-hidden="true" viewBox={socialIcons.instagram.viewBox} width="20" height="20">
                    {socialIcons.instagram.paths.map((path) => <path fill="currentColor" d={path} />)}
                  </svg>
                </a>
              )}
              {socialLinks.youtube && (
                <a href={socialLinks.youtube} target="_blank" rel="noopener noreferrer" aria-label="YouTube">
                  <svg aria-hidden="true" viewBox={socialIcons.youtube.viewBox} width="20" height="20">
                    {socialIcons.youtube.paths.map((path) => <path fill="currentColor" d={path} />)}
                  </svg>
                </a>
              )}
              {socialLinks.facebook && (
                <a href={socialLinks.facebook} target="_blank" rel="noopener noreferrer" aria-label="Facebook">
                  <svg aria-hidden="true" viewBox={socialIcons.facebook.viewBox} width="20" height="20">
                    {socialIcons.facebook.paths.map((path) => <path fill="currentColor" d={path} />)}
                  </svg>
                </a>
              )}
            </nav>
          )}
        </div>
        <a
          href="https://www.juntadeandalucia.es/"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Junta de Andalucía (abre en una pestaña nueva)"
        >
          <img
            class="footer-jda"
            src={`${base}/images/JdA.svg`}
            alt="Junta de Andalucía"
            width="135"
            height="36"
          />
        </a>
      </div>
      <div class="site-footer-credit">
        <a
          href="https://www.yadiragonzalez.com"
          target="_blank"
          rel="noopener noreferrer"
        >
          Diseñado con <span aria-hidden="true">❤</span>{' '}POR YADIRA GONZALEZ
        </a>
      </div>
    </footer>
    <script>
      const menu = document.querySelector<HTMLElement>('[data-site-menu]');
      const menuToggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
      const navFade = document.querySelector<HTMLElement>('.nav-fade');

      if (!menu || !menuToggle) {
        throw new Error('Mobile navigation controls are missing.');
      }

      if (!navFade) {
        throw new Error('Navigation fade is missing.');
      }

      const updateNavFade = () => {
        navFade.classList.toggle('is-visible', window.scrollY > 0);
      };

      window.addEventListener('scroll', updateNavFade, { passive: true });
      updateNavFade();

      const mobileViewport = window.matchMedia('(max-width: 760px)');
      const setMenuOpen = (isOpen: boolean, restoreFocus = true) => {
        menu.classList.toggle('is-open', isOpen);
        menu.setAttribute('aria-hidden', String(!isOpen));
        menuToggle.setAttribute('aria-expanded', String(isOpen));
        menuToggle.setAttribute('aria-label', isOpen ? 'Cerrar menú' : 'Abrir menú');
        document.body.classList.toggle('menu-open', isOpen);

        if (isOpen) {
          menu.querySelector<HTMLAnchorElement>('.site-menu-panel a')?.focus();
        } else if (restoreFocus) {
          menuToggle.focus();
        }
      };

      menuToggle.addEventListener('click', () => {
        setMenuOpen(menuToggle.getAttribute('aria-expanded') !== 'true');
      });

      menu.querySelectorAll<HTMLButtonElement>('[data-menu-close]').forEach((button) => {
        button.addEventListener('click', () => setMenuOpen(false));
      });

      menu.querySelectorAll<HTMLAnchorElement>('.site-menu-panel a').forEach((link) => {
        link.addEventListener('click', () => {
          if (mobileViewport.matches) setMenuOpen(false);
        });
      });

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && menu.classList.contains('is-open')) {
          setMenuOpen(false);
        }
      });

      mobileViewport.addEventListener('change', (event) => {
        if (!event.matches && menu.classList.contains('is-open')) {
          setMenuOpen(false, false);
        }
      });
    </script>
  </body>
  <script>
    document.querySelectorAll<HTMLAnchorElement>('a[href]').forEach((link) => {
      const href = link.getAttribute('href');
      if (!href) return;

      let url: URL;
      try {
        url = new URL(href, window.location.href);
      } catch {
        return;
      }

      if (url.origin !== window.location.origin) {
        link.target = '_blank';
        link.rel = 'noopener noreferrer';
      }
    });
  </script>
</html>

<style is:global>
  @font-face {
    font-family: Parkinsans;
    font-style: normal;
    font-weight: 400;
    font-display: swap;
    src: url('../assets/fonts/parkinsans-latin.woff2') format('woff2');
  }

  @font-face {
    font-family: 'Playwrite BE VLG';
    font-style: normal;
    font-weight: 100 400;
    font-display: swap;
    src: url('../assets/fonts/playwrite-be-vlg.woff2') format('woff2');
  }

  @font-face {
    font-family: 'Source Sans 3';
    font-style: normal;
    font-weight: 300 900;
    font-display: swap;
    src: url('../assets/fonts/source-sans-3-latin.woff2') format('woff2');
  }

  :root {
    --color-accent: #be1e2d;
    --color-heading: #1a1917;
    --color-text: #1a1917b3;
    font-family: 'Source Sans 3', sans-serif;
    color: var(--color-text);
    background: #f8f6f1;
  }

  body {
    display: flex;
    min-height: 100vh;
    flex-direction: column;
    margin: 0;
    font-size: 16px;
  }

  body.menu-open {
    overflow: hidden;
  }

  a {
    color: var(--color-accent);
  }

  .nav-fade {
    position: fixed;
    z-index: 9;
    top: 0;
    right: 0;
    left: 0;
    height: 8rem;
    pointer-events: none;
    opacity: 0;
    background: linear-gradient(
      to bottom,
      rgb(248 246 241 / 100%) 0,
      rgb(248 246 241 / 96%) 52%,
      rgb(248 246 241 / 0%) 100%
    );
    transition: opacity 180ms ease;
  }

  .nav-fade.is-visible {
    opacity: 1;
  }

  .site-header {
    position: sticky;
    top: 1rem;
    z-index: 10;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1.5rem;
    width: calc(100% - 2.5rem);
    max-width: 1200px;
    margin: 1.25rem auto 0;
    padding: .75rem .75rem .75rem 1.25rem;
    background: #fff;
    border-radius: 999px;
    box-shadow: 0 8px 30px rgb(23 32 54 / 8%);
  }

  .site-menu,
  .site-menu-panel {
    display: contents;
  }

  .menu-toggle,
  .mobile-contact,
  .site-menu-backdrop,
  .site-menu-close {
    display: none;
  }

  .brand {
    display: inline-flex;
    grid-column: 1;
    justify-self: start;
    align-items: center;
    flex-shrink: 0;
    text-decoration: none;
  }

  .brand img {
    display: block;
    width: auto;
    height: 48px;
  }

  .site-header nav {
    display: flex;
    grid-column: 2;
    align-items: center;
    gap: .25rem;
    justify-self: center;
    padding: .25rem;
    background: #f6f7fb;
    border-radius: 999px;
  }

  .nav-pages {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: .25rem;
  }

  .mobile-nav-pages {
    display: none;
  }

  .site-header nav a,
  .nav-contact {
    color: var(--color-text);
    font-weight: 500;
    text-decoration: none;
    padding: .55rem .75rem;
    border-radius: 999px;
  }

  .site-header nav a:hover,
  .nav-contact:hover {
    background: #f6f7fb;
    color: var(--color-heading);
  }

  .site-header nav a.active,
  .nav-contact.active {
    background: #fff;
    color: var(--color-accent);
    box-shadow: 0 4px 16px rgb(23 32 54 / 8%);
  }

  .menu-toggle:focus-visible,
  .mobile-contact:focus-visible,
  .site-menu-close:focus-visible {
    outline: 3px solid var(--color-accent);
    outline-offset: 3px;
  }

  .nav-contact {
    grid-column: 3;
    justify-self: end;
    align-self: stretch;
    display: flex;
    align-items: center;
    background: var(--color-accent);
    color: #fff;
  }

  .nav-contact:hover,
  .nav-contact.active {
    background: #a71825;
    color: #fff;
    box-shadow: 0 4px 16px rgb(190 30 45 / 20%);
  }

  main {
    flex: 1;
    width: 100%;
    box-sizing: border-box;
    max-width: 1200px;
    margin: 0 auto;
    padding: 3.5rem 1.25rem 5rem;
  }

  .page-content {
    flex: 1;
    width: 100%;
  }

  .page-content--with-sidenav {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 220px;
    align-items: start;
    gap: 1.5rem;
    max-width: 1200px;
    margin: 0 auto;
  }

  .page-content--with-sidenav > main {
    max-width: none;
    margin: 0;
  }

  .page-sidenav {
    position: sticky;
    top: 7rem;
    margin: 3.5rem 1.25rem 5rem 0;
  }

  .page-sidenav nav {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: .25rem;
    padding-left: .75rem;
    border-left: 1px solid #d8d3ca;
  }

  .page-sidenav a {
    display: block;
    padding: .5rem .65rem;
    color: var(--color-text);
    text-decoration: none;
  }

  .page-sidenav a.parent {
    font-weight: 600;
  }

  .page-sidenav a:hover {
    color: var(--color-heading);
  }

  .page-sidenav a.active {
    color: var(--color-accent);
    font-weight: 600;
  }

  .page-heading {
    max-width: 760px;
    margin: 0 0 2.5rem;
    text-align: left;
  }

  .eyebrow {
    margin: 0 0 .75rem;
    color: var(--color-accent);
    font-weight: 500;
    letter-spacing: .12em;
    text-transform: uppercase;
    text-align: left;
  }

  h1 {
    margin: .25rem 0 0;
    font-size: 64px;
    line-height: 1.05;
    text-align: left;
  }

  h1,
  h2,
  h3,
  h4,
  h5,
  h6 {
    color: var(--color-heading);
    font-family: Parkinsans, sans-serif;
    font-weight: 400;
    letter-spacing: -.04em;
  }

  .lede {
    color: var(--color-text);
    font-size: clamp(1.05rem, 2vw, 1.25rem);
    line-height: 1.65;
    margin: 1rem 0 0;
  }

  .site-footer {
    color: #fff;
    background: var(--color-accent);
  }

  .site-footer-content {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    column-gap: 2rem;
    row-gap: 1rem;
    box-sizing: border-box;
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem 1.25rem;
  }

  .site-footer-credit {
    box-sizing: border-box;
    max-width: 1200px;
    margin: 0 auto;
    padding: 1rem 1.25rem 1.5rem;
    border-top: 1px solid rgb(255 255 255 / 35%);
    text-align: center;
    font-family: monospace;
    font-size: 10px;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .site-footer-credit a {
    opacity: .5;
    text-decoration: underline;
    text-underline-offset: .15em;
    transition: opacity 150ms ease;
  }

  .site-footer-credit a:hover,
  .site-footer-credit a:focus-visible {
    opacity: 1;
  }

  .site-footer address {
    font-style: normal;
  }

  .footer-brand {
    display: block;
    width: 120px;
    max-width: 100%;
    height: 120px;
    filter: brightness(0) invert(1);
  }

  .footer-school-details {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
    font-size: 14px;
    font-weight: 300;
    text-align: left;
  }

  .footer-school-details address {
    flex: 0 1 auto;
    min-width: 0;
  }

  .footer-social-links {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    gap: .7rem;
  }

  .footer-social-links a {
    display: inline-flex;
    flex-shrink: 0;
    transition: opacity 150ms ease;
  }

  .footer-social-links a:hover {
    opacity: .75;
  }

  .footer-social-links a:focus-visible {
    border-radius: 3px;
    outline: 2px solid #fff;
    outline-offset: 4px;
  }

  .footer-jda {
    grid-column: 3;
    justify-self: end;
    display: block;
    width: auto;
    max-width: 100%;
    height: 36px;
  }

  .footer-school-details p {
    margin: .35rem 0 0;
  }

  .site-footer a {
    color: #fff;
    font-weight: 500;
    text-decoration: none;
  }

  @media (max-width: 900px) {
    .site-footer-content {
      grid-template-columns: auto minmax(0, 1fr);
    }

    .footer-jda {
      grid-column: 2;
      justify-self: start;
    }
  }

  @media (max-width: 760px) {
    h1 {
      font-size: 38px;
    }

    .site-footer-content {
      grid-template-columns: 1fr;
      justify-items: center;
      text-align: center;
    }

    .footer-school-details {
      align-items: center;
      text-align: center;
    }

    .footer-jda {
      grid-column: 1;
      justify-self: center;
    }

    .nav-fade {
      height: 11rem;
    }

    .site-header {
      display: grid;
      grid-template-columns: 2.75rem minmax(0, 1fr) 2.75rem;
      align-items: center;
      gap: .5rem;
      margin-top: 1rem;
      padding: .5rem .75rem .5rem 1rem;
      border-radius: 999px;
    }

    .brand {
      grid-column: 2;
      justify-self: center;
    }

    .brand img {
      height: 48px;
    }

    .menu-toggle {
      grid-column: 1;
      justify-self: start;
      display: grid;
      width: 2.75rem;
      height: 2.75rem;
      place-items: center;
      padding: 0;
      border: 0;
      border-radius: 50%;
      color: var(--color-heading);
      background: #f6f7fb;
      cursor: pointer;
    }

    .mobile-contact {
      grid-column: 3;
      justify-self: end;
      display: grid;
      width: 2.75rem;
      height: 2.75rem;
      place-items: center;
      border-radius: 50%;
      color: var(--color-heading);
      background: #f6f7fb;
      text-decoration: none;
    }

    .menu-toggle-icon {
      display: grid;
      gap: 4px;
    }

    .menu-toggle-icon span {
      display: block;
      width: 20px;
      height: 2px;
      border-radius: 2px;
      background: currentColor;
    }

    .site-menu,
    .site-menu.is-open {
      position: fixed;
      z-index: 20;
      inset: 0;
      display: block;
      visibility: hidden;
      pointer-events: none;
    }

    .site-menu.is-open {
      visibility: visible;
      pointer-events: auto;
    }

    .site-menu-backdrop {
      position: absolute;
      inset: 0;
      display: block;
      width: 100%;
      height: 100%;
      padding: 0;
      border: 0;
      opacity: 0;
      background: rgb(23 32 54 / 50%);
      transition: opacity 200ms ease;
      cursor: pointer;
    }

    .site-menu.is-open .site-menu-backdrop {
      opacity: 1;
    }

    .site-menu-panel {
      position: absolute;
      top: 0;
      right: 0;
      bottom: 0;
      display: flex;
      width: min(85vw, 22rem);
